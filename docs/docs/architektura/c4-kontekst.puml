Rel(gos, dk, "sprawdza wejścia i bariery")
Rel(odw, dk, "zgłasza barierę")
Rel(zbi, dk, "zaznacza bariery na miejscu")
Rel(wer, dk, "przyjmuje albo odrzuca")
Rel(koo, dk, "zaprasza, śledzi postęp, eksportuje")

Rel(dk, kc, "logowanie, role, zaproszenia", "OAuth 2.0, OIDC")
Rel(dk, arc, "import pięter i pomieszczeń", "HTTPS")
Rel(dk, osm, "eksport konturów", "Overpass API")
Rel(dk, tiles, "kafelki, tylko online", "HTTPS")

SHOW_LEGEND()
@enduml
