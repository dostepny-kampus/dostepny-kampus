@startuml
!pragma layout smetana
!include <C4/C4_Context>
!$LEGEND_TITLE_TEXT = "Legenda"
HIDE_STEREOTYPE()
UpdateElementStyle("person", $legendText="rola")
UpdateElementStyle("system", $legendText="nasz system")
