Person(gos, "Gość niezalogowany", "RO-GOS")
Person(odw, "Odwiedzający", "RO-ODW")
Person(zbi, "Zbierający", "RO-ZBI")
Person(wer, "Weryfikator", "RO-WER")
Person(koo, "Koordynator", "RO-KOO")

System(dk, "Dostępny Kampus", "aplikacja mobilna i serwer: mapa barier, zgłoszenia, weryfikacja, postęp")

System_Ext(kc, "Usługa logowania", "Keycloak: konta, role, rejestracja, zaproszenia")
