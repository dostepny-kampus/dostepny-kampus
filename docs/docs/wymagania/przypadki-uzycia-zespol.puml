@startuml
!pragma layout smetana
left to right direction
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
}
skinparam rectangle {
  BorderColor #1F4E79
}

title Inwentaryzacja barier: zbieranie, weryfikacja, koordynacja

actor "Odwiedzający\n(RO-ODW)" as ODW
actor "Zbierający\n(RO-ZBI)" as ZBI
actor "Weryfikator\n(RO-WER)" as WER
actor "Koordynator\n(RO-KOO)" as KOO
actor "Usługa\nlogowania" as UL <<system>>

ODW <|-- ZBI
ODW <|-- WER
ODW <|-- KOO

rectangle "Dostępny Kampus" {
  usecase "UC8\nPomiar precyzyjny\ni zapis zgłoszenia" as UC8
  usecase "UC9\nŚledzenie i poprawa\nwłasnych zgłoszeń" as UC9
  usecase "UC12\nZgłoszenie\nusunięcia bariery" as UC12
  usecase "UC13\nOznaczenie\npiętra obejrzanego" as UC13
  usecase "UC10\nSynchronizacja\nz serwerem" as UC10
  usecase "UC11\nWybór wersji\nprzy konflikcie" as UC11
  usecase "UC14\nWeryfikacja zgłoszenia" as UC14
  usecase "UC15\nPrzegląd postępu\ninwentaryzacji" as UC15
  usecase "UC16\nZaproszenie\nosoby z rolą" as UC16
  usecase "UC17\nEksport do QGIS" as UC17
}

ZBI -- UC8
ZBI -- UC9
ZBI -- UC12
ZBI -- UC13
ZBI -- UC10
WER -- UC14
KOO -- UC15
KOO -- UC16
KOO -- UC17

UC8 ..> UC10 : <<include>>
UC12 ..> UC10 : <<include>>
UC13 ..> UC10 : <<include>>
UC10 <.. UC11 : <<extend>>\ninna wersja\nna serwerze

UC16 -- UL
@enduml
