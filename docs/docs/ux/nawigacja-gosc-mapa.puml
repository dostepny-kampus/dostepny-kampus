@startuml
!include _nawigacja.iuml

start
if (pierwsze uruchomienie?) then (tak)
  :V5 Pomoc;
  -> „Zacznij” albo\n„Pomiń instrukcję”;
else (nie)
endif
:V1 Mapa kampusu;
split
  -> budynek na mapie albo\nwynik wyszukiwania budynku;
  :V2 Karta budynku;
  split
    -> „Pokaż wejście\nna mapie” albo\nwiersz wejścia;
    :V1 Arkusz wejścia\nz zaznaczonym wejściem; <<stan>>
    split
      -> „Wstecz” albo\n„Budynek A-1”;
      :V2 Karta budynku\nna tej samej wysokości;
      detach
    split again
      -> „Zamknij”;
      :V1 Mapa kampusu;
      detach
    split again
      -> „Zgłoś barierę\nprzy wejściu”;
      :V4 Zgłoszenie szybkie\n(następny rysunek);
      detach
    end split
  split again
    -> „Pokaż\nna planie”;
    :V1 Plan piętra\nna mapie; <<stan>>
    detach
  split again
    -> „Zgłoś barierę przy wejściu”\nw wierszu wejść bez danych;
    :V4 Zgłoszenie szybkie\n(następny rysunek);
    detach
  split again
    -> „Wstecz”,\n„Zamknij”;
    :V1 Mapa kampusu;
    detach
  end split
split again
  -> dotknięcie znaku wejścia,\ntoalety, schodów albo bariery;
  :V1 Arkusz znaku; <<stan>>
  split
    -> „Budynek A-1”;
    :V2 Karta budynku\nna niskiej wysokości;
    detach
  split again
    -> „Zgłoś barierę\nprzy wejściu”\nw arkuszu wejścia;
    :V4 Zgłoszenie szybkie\n(następny rysunek);
    detach
  end split
split again
  -> przybliżenie budynku\nszczegółowego;
  :V1 Plan piętra\nna mapie; <<stan>>
  split
    -> dotknięcie\nwindy;
    :V1 Arkusz windy; <<stan>>
    -> „Zamknij”;
    :V1 Plan piętra\nna mapie; <<stan>>
    detach
  split again
    -> oddalenie;
    :V1 Mapa kampusu;
    detach
  end split
split again
  -> wynik „A-1 329”;
  :V1 Plan piętra\nze znalezioną salą; <<stan>>
  -> „Budynek A-1”;
  :V2 Karta budynku\nna niskiej wysokości;
  detach
end split
@enduml
