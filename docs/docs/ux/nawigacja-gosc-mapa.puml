@startuml
!include _nawigacja.iuml

start
if (pierwsze uruchomienie?) then (tak)
  :V5 Pomoc;
  -> „Zacznij” albo\n„Pomiń instrukcję”;
else (nie)
endif
:V1 Mapa kampusu;
split
  -> budynek na mapie albo\nwynik wyszukiwania budynku;
  :V2 Karta budynku;
  split
    -> „Sprawdź,\nktórędy wejść”;
    :V3 Którędy wejść;
    -> „Pokaż wejście\nna mapie”;
    :V1 Mapa kampusu\nz zaznaczonym wejściem;
    detach
  split again
    -> „Pokaż\nna planie”;
    :V1 Plan piętra\nna mapie; <<stan>>
    detach
  split again
    -> „Zgłoś barierę\nprzy wejściu”;
    :V4 Zgłoszenie szybkie\n(następny rysunek);
    detach
  split again
    -> „Wstecz”,\n„Zamknij”;
    :V1 Mapa kampusu;
    detach
  end split
split again
  -> przybliżenie budynku\nszczegółowego;
  :V1 Plan piętra\nna mapie; <<stan>>
  split
    -> dotknięcie\nwindy;
    :V1 Arkusz windy; <<stan>>
    -> „Zamknij”;
    :V1 Plan piętra\nna mapie; <<stan>>
    detach
  split again
    -> oddalenie;
    :V1 Mapa kampusu;
    detach
  end split
split again
  -> wynik „A-1 329”;
  :V1 Plan piętra\nze znalezioną salą; <<stan>>
  -> „Pokaż opis\nbudynku”;
  :V2 Karta budynku;
  detach
end split
@enduml
