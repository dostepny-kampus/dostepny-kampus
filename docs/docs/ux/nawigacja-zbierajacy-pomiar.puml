@startuml
!include _nawigacja.iuml

start
:V1 Mapa kampusu;
-> „Konto i praca”\nw pasku dolnym;
:L2 Konto i praca;
split
  -> „Zmierz i zgłoś\nbarierę”;
  :C1 Pomiar pozycji;
  -> „Dalej”;
  :C2 Formularz zgłoszenia;
  -> „Zapisz”;
  :C3 Moje zgłoszenia;
  detach
split again
  -> „Moje zgłoszenia”;
  :C3 Moje zgłoszenia;
  split
    -> zgłoszenie\ndo poprawy;
    :C2 Formularz zgłoszenia;
    -> „Zapisz”;
    :C3 Moje zgłoszenia;
    detach
  split again
    -> „Dwie wersje:\nwybierz jedną”;
    :C4 Synchronizacja\ni wybór wersji;
    -> wybór wersji albo\n„Zdecyduję później”;
    :C3 Moje zgłoszenia;
    detach
  split again
    -> „Zmierz i zgłoś\nbarierę”;
    :C1 Pomiar pozycji;
    detach
  end split
end split
@enduml
