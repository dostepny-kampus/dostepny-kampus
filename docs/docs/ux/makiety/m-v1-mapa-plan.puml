@startsalt
' V1 Mapa kampusu, plan piętra po przybliżeniu budynku szczegółowego (US16.1): piętro wejścia zalecanego,
' kolumna pięter po prawej pod przyciskami mapy, sąsiednie budynki przygaszone, podpis źródła.
!include _wspolne.iuml
!include _odwiedzajacy.iuml
$ekran_poczatek()
$naglowek_startowy("Mapa kampusu")
$pole_tekstowe("Wpisz symbol budynku, np. C-13")
$przelacznik("Mapa", "Lista budynków", 1)
$przycisk("Kampus główny ▾")
$przycisk("Legenda")
$ramka()
.
$tekst("[plan parteru A-1: sale, korytarze, klatki, windy i toalety w kolorach grup, numery sal]", "i")
$tekst("[sąsiednie budynki przygaszone, z podpisami]", "i")
.
$przyciski_obok("Powiększ", "Pomniejsz")
{
  . | [<&caret-top>] | . | $dk_spacje(12) | <b>Piętro</b>
  [<&caret-left>] | . | [<&caret-right>] | . | [3]
  . | [<&caret-bottom>] | . | . | [2]
  . | . | . | . | [1]
  . | . | . | . | <b>(0)</b>
  . | . | . | . | [-1]
}
{ [<&info>] | <u>© OpenStreetMap contributors</u> }
}
Źródło: Politechnika Wrocławska
$pasek_dolny_konto()
$ekran_koniec()
@endsalt
