@startsalt
' V2 Karta budynku, stan pusty: brak zgłoszeń przyjętych (UC2 2a), budynek szczegółowy.
!include _wspolne.iuml
!include _odwiedzajacy.iuml
$ekran_poczatek()
$naglowek_karty("<i>[symbol]</i>", "<i>[nazwa budynku z danych]</i>")
$karta_gora(1, "dostepne", "Zalecane: „<i>[nazwa]</i>”.")
$sekcja("Wejścia")
$wejscia_poczatek()
$wejscie_pierwsze($dostepne(), "<i>[nazwa wejścia z danych]</i>", "Zalecane", "Sprawdzone na miejscu <i>[data]</i>")
$wejscie_karty($niedostepne(), "<i>[nazwa wejścia z planów]</i>", "", "Z planów Politechniki Wrocławskiej, stan z <i>[data]</i>", "", "[opis dojścia i szerokość drzwi z planów PWr]")
$wejscia_koniec()
$przycisk("Pokaż wyjścia ewakuacyjne (2)")
$grupy_pwr()
$sekcja("Bariery w budynku")
$ramka()
<b>Brak zgłoszonych barier</b>
$tekst("Bariera pojawi się tutaj, gdy ktoś ją zgłosi i zostanie sprawdzona.")
$przycisk("Zgłoś barierę", "camera-slr")
}
$karta_dol()
$pasek_dolny_konto()
$ekran_koniec()
@endsalt
