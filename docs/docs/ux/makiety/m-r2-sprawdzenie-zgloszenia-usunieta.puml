@startsalt
' R2 Sprawdzenie zmiany "bariera usunięta" (BR-19). Równoległą zmianę autora przyjął
' już inny Weryfikator, więc ta zmiana dotyczy zgłoszenia archiwalnego: powód "Nieaktualne" (BR-23).
!include _wspolne.iuml
' Fragmenty lokalne R2 (propozycja do _wspolne.iuml, zob. opis PR).
' Decyzja: „Przyjmij” jako czynność główna, pod nią powód odrzucenia i „Odrzuć”.
' $powod: "" (nic nie wybrano), "Duplikat" albo "Nieaktualne".
!procedure $r2_decyzja($powod="")
..
$przycisk_glowny("Przyjmij")
<b>Powód odrzucenia</b>
!if $powod == "Duplikat"
(X) Duplikat
{
$dk_spacje(3) | Wcześniejsze zgłoszenie:
$dk_spacje(3) | (X) schody przy wejściu, 2 m
$dk_spacje(3) | ( ) próg, 5 m
}
!else
( ) Duplikat
!endif
!if $powod == "Nieaktualne"
(X) Nieaktualne
!else
( ) Nieaktualne
!endif
"$dk_spacje(30)"
$przycisk("Odrzuć")
!endprocedure
' Zdjęcie z przyciskiem zasłaniania twarzy i tablic (BR-15, NFR-25).
!procedure $r2_zdjecie($opis)
$obraz($opis)
$przycisk("Zasłoń twarz lub tablicę")
!endprocedure
$ekran_poczatek()
$naglowek("Sprawdzenie zgłoszenia")
<b>Bariery już nie ma</b>
niesprawna winda
Budynek D-2, piętro <i>[piętro]</i>
Miejsce: <i>[punkt z poprzedniego]</i>
{
{+
.
<i>[zdjęcie z</i>
<i>poprzedniego</i>
<i>zgłoszenia]</i>
.
} | {+
.
<i>[nowe zdjęcie </i>
<i>miejsca]</i>
.
.
}
}
$przycisk("Zasłoń twarz lub tablicę")
Autor: Zbierający, Autor <i>[nr]</i>
$sekcja("Podobne zgłoszenia do 10 m")
{+
<b>niesprawna winda</b>$dk_spacje(16)
$tylko_z_pomoca()
$obraz("zdjęcie")
0 m, piętro <i>[piętro]</i>
$przyjete()
}
$r2_decyzja("Nieaktualne")
$ekran_koniec()
@endsalt
