' Nad kartą sama mapa z przyciskami, bez nagłówka, pola symbolu i przełącznika (NFR-53; decyzja 151).
' Pod kreską wystaje nagłówek „Wejścia” i ucięty następny wiersz; chipów nie ma.
!include _wspolne.iuml
!include _odwiedzajacy.iuml
$ekran_poczatek()
$mapa("mapa ulic OpenStreetMap; kontur A-1 wyróżniony, sąsiednie przygaszone, wejścia A-1 ze znakami oznaczeń", "", "przyciski")
$ramka()
$tekst("[uchwyt; TalkBack: Wysokość karty, niska]", "i")
$naglowek_karty("A-1", "<i>[nazwa budynku z danych]</i>")
$karta_gora(0)
<b>Wejścia</b>
<i>[ucięty pierwszy wiersz grupy]</i>
}
$pasek_dolny_konto()
$ekran_koniec()
