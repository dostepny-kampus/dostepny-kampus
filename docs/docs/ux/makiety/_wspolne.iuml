' Wspólne fragmenty makiet low-fi „Dostępny Kampus” (PlantUML Salt).
' Rozszerzenie .iuml: scripts/render.py nie renderuje tego pliku osobno.
'
' Użycie w makiecie docs/ux/makiety/m-<ekran>-<nazwa>[-<stan>].puml:
'
'   (wiersz otwierający blok Salt)
'   !include _wspolne.iuml
'   $ekran_poczatek()
'   $naglowek("Budynek A-1")
'   ...treść ekranu...
'   $pasek_dolny_konto()
'   $ekran_koniec()
'   (wiersz zamykający blok Salt)
'
' Napisy i ikony pochodzą ze słownika użytkownika (docs/ux/slownik-uzytkownika.md).
' Zmiana napisu albo ikony: najpierw słownik, potem ten plik, nigdy sama makieta.

' ---------- Ramka telefonu: stała szerokość i skala ----------

' Najwięcej znaków w wierszu tekstu. Wiersz tekstu 12 px w ramce 240 px
' odpowiada tekstowi 18 sp na ekranie 360 dp (NFR-20: duży tekst).
!$DK_MAKS = 34
' Liczba spacji o stałej szerokości (U+2007) w niewidocznym wierszu ramki.
!$DK_RAMKA = 236

' Zwraca $n spacji o stałej szerokości. Zwykłe spacje Salt obcina.
!function $dk_spacje($n)
!local $s = ""
!local $i = 0
!while $i < $n
!$s = $s + %chr(8199)
!$i = $i + 1
!endwhile
!return $s
!endfunction

' Otwiera ramkę ekranu. Pierwszy wiersz jest niewidoczny i ustala szerokość.
!procedure $ekran_poczatek()
scale 2
{+
<size:2>$dk_spacje($DK_RAMKA)</size>
!endprocedure

' Zamyka ramkę ekranu.
!procedure $ekran_koniec()
}
!endprocedure

' ---------- Tekst ----------

' Tekst zawinięty do $DK_MAKS znaków w wierszu, łamany na spacjach.
' Zastępnik w tekście pisz bez spacji w środku, np. <i>[data]</i>,
' bo łamanie wiersza w środku znacznika <i> psuje kursywę.
' $styl: "" (zwykły), "b" (pogrubiony) albo "i" (kursywa: zastępnik treści).
!procedure $tekst($t, $styl="")
!local $r = $t
!local $c = 0
!while %strlen($r) > $DK_MAKS
!$c = $DK_MAKS
!while (%substr($r, $c, 1) != " ") && ($c > 0)
!$c = $c - 1
!endwhile
!if $c == 0
!$c = $DK_MAKS
!endif
!if $styl == ""
%substr($r, 0, $c)
!else
<$styl>%substr($r, 0, $c)</$styl>
!endif
!$r = %substr($r, $c + 1)
!endwhile
!if $styl == ""
$r
!else
<$styl>$r</$styl>
!endif
!endprocedure

' Nagłówek sekcji na ekranie, np. „Bariery w budynku”.
!procedure $sekcja($t)
..
<b>$t</b>
!endprocedure

' Zastępnik obrazu (zdjęcie, plan, mapa): ramka z opisem w kursywie i nawiasach.
!procedure $obraz($opis)
{+
.
$tekst("[" + $opis + "]", "i")
.
}
!endprocedure

' ---------- Przyciski ----------

' Salt liczy szerokość przycisku jak dla pisma o stałej szerokości: 8 px na znak,
' także na spację U+2007 (zmierzone na PNG). Dlatego każdy przycisk na pełną
' szerokość ma $DK_PRZYCISK znaków (tyle co najdłuższy napis: „Pozwól na dokładną
' lokalizację”), a przycisk w parze obok drugiego $DK_PRZYCISK_POL znaków.
' Dopełnienie jest liczone łącznie: po lewej połowa z obcięciem, po prawej reszta,
' więc napis o nieparzystej długości nie traci spacji.
!$DK_PRZYCISK = 30
!$DK_PRZYCISK_POL = 14

' Napis przycisku z ikoną albo bez, dopełniony do $szer znaków.
!function $dk_napis($t, $ikona, $szer)
!local $dl = %strlen($t)
!if $ikona != ""
!$dl = $dl + 3
!endif
!local $dop = $szer - $dl
!if $dop < 0
!$dop = 0
!endif
!local $lewo = $dop / 2
!local $w = $t
!if $ikona != ""
!$w = "<&" + $ikona + "> " + $t
!endif
!return $dk_spacje($lewo) + $w + $dk_spacje($dop - $lewo)
!endfunction

' Napis przycisku na pełną szerokość ramki.
!function $dk_przycisk($t, $ikona)
!return $dk_napis($t, $ikona, $DK_PRZYCISK)
!endfunction

' Czynność główna ekranu: pełna szerokość, pogrubiona (NFR-21: wyróżnienie
' położeniem i rozmiarem, nie kolorem). Jedna na ekranie.
!procedure $przycisk_glowny($t, $ikona="")
[<b>$dk_przycisk($t, $ikona)</b>]
!endprocedure

' Zwykła czynność: pełna szerokość, zwykła czcionka.
!procedure $przycisk($t, $ikona="")
[$dk_przycisk($t, $ikona)]
!endprocedure

' Dwa zwykłe przyciski obok siebie, każdy na pół szerokości (NFR-17).
!procedure $przyciski_obok($t1, $t2)
{ [$dk_napis($t1, "", $DK_PRZYCISK_POL)] | [$dk_napis($t2, "", $DK_PRZYCISK_POL)] }
!endprocedure

' ---------- Nagłówek ekranu ----------

' Nagłówek z „Wstecz” (strzałka w lewo i słowo, zawsze w tym samym miejscu) i tytułem (PW-11).
' $podtytul: drugi wiersz, np. nazwa budynku z danych na V2.
!procedure $naglowek($tytul, $podtytul="")
{ [<&arrow-left> Wstecz] | <b>$tytul</b> }
!if $podtytul != ""
$podtytul
!endif
--
!endprocedure

' Nagłówek bez „Wstecz” — tylko V1, ekran startowy.
!procedure $naglowek_startowy($tytul)
<b>$tytul</b>
--
!endprocedure

' ---------- Wskaźnik braku internetu ----------

' Pod nagłówkiem jedna linia „Bez internetu · dane z 12.11.2026” (decyzja 54, PW-4).
' $dopisek po „·”: dla Gościa i Odwiedzającego "dane z 12.11.2026", dla Zbierającego
' "Ostatnia synchronizacja: 12.11.2026, 10:42". Dopisek stoi w drugim wierszu w całości,
' bo w ramce 34 znaków nie mieści się obok. Bez dopisku samo „Bez internetu”, gdy
' w telefonie nie ma jeszcze danych (decyzja 84).
!procedure $brak_internetu($dopisek="")
{+
!if $dopisek != ""
<&wifi> <b>Bez internetu</b> ·
$tekst($dopisek)
!else
<&wifi> <b>Bez internetu</b>
!endif
}
!endprocedure

' ---------- Pasek dolny ----------

' Cztery pozycje: ikona nad napisem. Tylko na V1, V2, V3, V5 i L2.
' Napis „Konto” jest dopełniony do długości „Konto i praca”, więc pasek ma
' tę samą szerokość dla wszystkich ról.
!procedure $dk_pasek($konto, $dopelnienie)
!local $d = $dk_spacje(1)
!local $k = $konto + $dk_spacje($dopelnienie)
--
{# {<&map>
Mapa$d} | {<&camera-slr>
Zgłoś barierę$d} | {<&question-mark>
Pomoc$d} | {<&person>
$k$d} }
!endprocedure

' Gość i Odwiedzający.
!procedure $pasek_dolny_konto()
$dk_pasek("Konto", 6)
!endprocedure

' Osoba z co najmniej jedną rolą pracowniczą (PW-1).
!procedure $pasek_dolny_praca()
$dk_pasek("Konto i praca", 0)
!endprocedure

' ---------- Komunikat stanu ----------

' Ramka na pełną szerokość, także bez przycisków: co się stało i co zrobić
' (najwyżej 2 zdania), pod nią przyciski
' tej samej wielkości, jeden pod drugim. Treść z katalogu komunikatów.
!procedure $komunikat($tresc, $p1="", $p2="")
$ramka()
$tekst($tresc)
!if $p1 != ""
$przycisk($p1)
!endif
!if $p2 != ""
$przycisk($p2)
!endif
}
!endprocedure

' ---------- Oznaczenia: zawsze tekst i ikona (NFR-21) ----------

' Oznaczenie wejścia.
!function $dostepne()
!return "<&check> Dostępne"
!endfunction
!function $niedostepne()
!return "<&x> Niedostępne"
!endfunction
!function $brak_danych()
!return "<&minus> Brak danych"
!endfunction

' Uciążliwość bariery (PW-13).
!function $utrudnienie()
!return "<&warning> Utrudnienie"
!endfunction
!function $tylko_z_pomoca()
!return "<&people> Tylko z pomocą"
!endfunction
!function $blokada()
!return "<&ban> Blokada"
!endfunction

' Status zgłoszenia (role zespołu).
!function $w_telefonie()
!return "<&phone> W telefonie"
!endfunction
!function $wyslane()
!return "<&data-transfer-upload> Wysłane"
!endfunction
!function $w_weryfikacji()
!return "<&eye> W weryfikacji"
!endfunction
!function $przyjete()
!return "<&circle-check> Przyjęte"
!endfunction
!function $odrzucone()
!return "<&circle-x> Odrzucone"
!endfunction
!function $archiwalne()
!return "<&box> Archiwalne"
!endfunction

' Znacznik piętra (C5) i budynku podstawowego (K1). Forma „nie…” bez ikony (PW-11).
!function $obejrzane()
!return "<&task> Obejrzane"
!endfunction
!function $nieobejrzane()
!return "Nieobejrzane"
!endfunction
!function $obejrzany()
!return "<&task> Obejrzany"
!endfunction
!function $nieobejrzany()
!return "Nieobejrzany"
!endfunction

' ---------- Ramka pozycji i pola formularza ----------

' Otwiera ramkę pozycji listy na pełną szerokość ekranu: pierwszy wiersz jest
' niewidoczny i ustala szerokość. Ramkę zamyka zwykłe „}”.
' Pozycję składa się w niej ręcznie, gdy $pozycja nie wystarcza.
!procedure $ramka()
{+
<size:2>$dk_spacje(230)</size>
!endprocedure

' Pole tekstowe na pełną szerokość ramki. $wpis: podpowiedź, wpisany tekst albo
' "" (pole puste). Szerokość nie zależy od długości wpisu. W komórce tabeli,
' gdzie procedura nie działa, wpisuje się funkcję $dk_pole(wpis, szerokość).
!$DK_POLE = 31
!function $dk_pole($wpis, $szer)
!local $pol = $szer - %strlen($wpis)
!if $pol < 0
!$pol = 0
!endif
!return %chr(34) + $wpis + $dk_spacje($pol) + %chr(34)
!endfunction
!procedure $pole_tekstowe($wpis="", $szer=$DK_POLE)
$dk_pole($wpis, $szer)
!endprocedure

' Błąd przy polu: ten sam tekst co w podsumowaniu nad formularzem
' (NFR-15, WCAG 3.3.1). Pogrubienie i położenie, nie kolor (NFR-21).
!procedure $blad_pola($t)
$tekst($t, "b")
!endprocedure

' Opcja wyboru jednej wartości w ramce na pełną szerokość (NFR-17).
' $wybrane: "X" dla wybranej, "" dla pozostałych. $tresc z ikoną z funkcji oznaczeń.
!procedure $opcja($wybrane, $tresc, $opis="")
$ramka()
!if $wybrane == "X"
(X) <b>$tresc</b>
!else
( ) $tresc
!endif
!if $opis != ""
$tekst($opis)
!endif
}
!endprocedure

' Przełącznik dwóch widoków, np. „Mapa” i „Lista budynków” (NFR-19). Wybraną
' pozycję widać po kształcie pola, a nie po kolorze (NFR-21). $wybrana: 1 albo 2.
!procedure $przelacznik($p1, $p2, $wybrana=1)
!if $wybrana == 2
{ ( ) $p1$dk_spacje(4) | (X) $p2 }
!else
{ (X) $p1$dk_spacje(4) | ( ) $p2 }
!endif
!endprocedure

' Wybór piętra: „Piętro:” robi makieta, tu etykiety z danych PWr jako zastępniki.
' $wybrane: numer wybranego piętra albo 0 (nic nie wybrano). $liczba: ile pięter.
!procedure $pietra($wybrane=0, $liczba=5)
!local $w = ""
!local $i = 1
!while $i <= $liczba
!if $i > 1
!$w = $w + " | "
!endif
!if $i == $wybrane
!$w = $w + "(X) "
!else
!$w = $w + "( ) "
!endif
!$w = $w + "<i>[" + $i + "]</i>"
!if $i < $liczba
!$w = $w + $dk_spacje(2)
!endif
!$i = $i + 1
!endwhile
{ $w }
!endprocedure

' Komunikat ostrzegawczy przed czynnością (decyzja 54, PW-13): w ramce koło ze znakiem
' „!”, pogrubione „Ważne”, wymaganie i zdanie z powodem. W low-fi koło to „(!)”.
' Trójkąt należy do uciążliwości „Utrudnienie”, więc komunikat go nie używa.
!procedure $wazne($wymaganie, $powod)
$ramka()
<b>(!) Ważne</b>
$tekst($wymaganie)
$tekst($powod)
}
!endprocedure

' Zdjęcie w formularzu (C2, C6, C7): komunikat „Ważne” o wizerunku, jak na V4,
' i przycisk z ikoną aparatu (NFR-25, PW-8). $opis: zastępnik zrobionego zdjęcia;
' pusty, gdy zdjęcia jeszcze nie ma. Krok 1 V4 składa te same elementy ręcznie,
' bo ma tam czynność główną.
!procedure $zdjecie($opis="")
$wazne("Nie fotografuj twarzy ani tablic rejestracyjnych.", "Zdjęcie zobaczą inni użytkownicy.")
!if $opis == ""
$przycisk("Zrób zdjęcie", "camera-slr")
!else
$obraz($opis)
$przycisk("Zrób nowe zdjęcie", "camera-slr")
!endif
!endprocedure

' ---------- Mapa ----------

' Napis o prawach autorskich OpenStreetMap jako odnośnik, zawsze w ramce mapy (NFR-37).
!procedure $osm()
<u>© OpenStreetMap contributors</u>
!endprocedure

' Zastępnik mapy na pełną szerokość, z podpisem OpenStreetMap w ramce (NFR-37).
' $opis: co widać na mapie. $legenda: przykład oznaczeń na mapie tekstem i ikoną
' (NFR-21), np. $blokada() na V1; pusta, gdy mapa nie pokazuje barier.
' $kontrolki: "" (bez przycisków), "mapa" (same przyciski mapy)
' albo "info" (przyciski mapy i „ⓘ” przy podpisie OpenStreetMap, V1 i R1; C1: $punkt_na_srodku).
!procedure $mapa($opis, $legenda="", $kontrolki="")
$ramka()
.
$tekst("[" + $opis + "]", "i")
.
!if $legenda != ""
<i>[przykład oznaczeń na mapie:]</i>
$legenda
.
!endif
!if $kontrolki != ""
$przyciski_mapy()
!endif
!if $kontrolki == "info"
{ [<&info>] | <u>© OpenStreetMap contributors</u> }
!else
$osm()
!endif
}
!endprocedure

' Przyciski mapy zamiast gestów, na mapie: „Powiększ” i „Pomniejsz” oraz groty (caret)
' przesuwania w krzyżu, każdy z nazwą dla TalkBack „Przesuń mapę w górę” itd.
' Ten sam układ na V1, C1 i R1 (NFR-15, WCAG 2.5.1, 2.5.7; NFR-17; PW-8, PW-11; decyzja 93).
!procedure $przyciski_mapy()
$przyciski_obok("Powiększ", "Pomniejsz")
{
. | [<&caret-top>] | .
[<&caret-left>] | . | [<&caret-right>]
. | [<&caret-bottom>] | .
}
!endprocedure

' ---------- Szablony pozycji listy ----------

' Wejście: oznaczenie jako pierwsza informacja, tuż pod nim data i źródło
' (US17.3). $zrodlo bez zawijania: najwyżej 34 widoczne znaki.
' $akcja tylko dla Zbierającego: "Zmień oznaczenie".
!procedure $wejscie($oznaczenie, $nazwa, $zrodlo, $akcja="")
$ramka()
<b>$oznaczenie</b>: $nazwa
$zrodlo
!if $akcja != ""
$przycisk($akcja)
!endif
}
!endprocedure

' Ogólna pozycja listy: tytuł, oznaczenie (tekst i ikona), dopisek, przycisk.
' Bardziej złożoną pozycję składa się ręcznie w $ramka() … }.
!procedure $pozycja($tytul, $oznaczenie="", $dopisek="", $akcja="")
$ramka()
$tekst($tytul, "b")
!if $oznaczenie != ""
$oznaczenie
!endif
!if $dopisek != ""
$tekst($dopisek)
!endif
!if $akcja != ""
$przycisk($akcja)
!endif
}
!endprocedure
