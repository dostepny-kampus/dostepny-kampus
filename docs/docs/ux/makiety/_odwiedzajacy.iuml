' Fragmenty makiet grupy „odwiedzający” (V1–V5, L1, L2), których nie ma w _wspolne.iuml.
' Rozszerzenie .iuml: scripts/render.py nie renderuje tego pliku osobno.
' Dołączać po _wspolne.iuml, bo korzysta z jego funkcji.
' Pole tekstowe, przełącznik, mapa z przyciskami i szerokość przycisków są w _wspolne.iuml.

' Numer kroku, np. „Krok 1 z 3” (US4.1, US5.1). Tylko V4 i V5.
!procedure $numer_kroku($t)
<b>$t</b>
!endprocedure

' ---------- V2 Karta budynku (decyzje 48, 115) ----------

' Góra pełnego ekranu, bez mapy: chipy faktów z danych, wiersz o wejściach i czynność główna w treści.
' $chipy: 1 — „Wejście dostępne”, „Winda”, „Toaleta dostosowana”; 0 — bez chipów.
' $wejscia: napis wiersza o wejściach (US2.8).
!procedure $karta_gora($chipy=1, $wejscia="Wejście dostępne")
!if $chipy == 1
{ [$dk_napis("Wejście dostępne", "", 17)] | [$dk_napis("Winda", "", 11)] }
$przycisk("Toaleta dostosowana")
!endif
<b>$wejscia</b>
$przycisk_glowny("Sprawdź, którędy wejść")
!endprocedure

' Wejście na karcie: oznaczenie, przy wejściu zalecanym „Zalecane” z piętrem (BR-25),
' nazwa, opis z danych, „Pokaż wejście na mapie” tylko przy zalecanym i „Zgłoś barierę przy wejściu”
' (TalkBack: „Zgłoś barierę przy wejściu: nazwa wejścia”, WCAG 2.5.3).
' $zrodlo: data i źródło przy wejściu, gdy nie są wspólne dla wszystkich (BR-24).
' $akcja tylko dla Zbierającego: "Zmień oznaczenie".
!procedure $wejscie_karty($oznaczenie, $nazwa, $zalecane="", $zrodlo="", $akcja="")
$ramka()
<b>$oznaczenie</b>$dk_spacje(2)$zalecane
<b>$nazwa</b>
$tekst("[opis i szerokość drzwi z danych]", "i")
!if $zrodlo != ""
$zrodlo
!endif
!if $zalecane != ""
$przycisk("Pokaż wejście na mapie")
!endif
$przycisk("Zgłoś barierę przy wejściu")
!if $akcja != ""
$przycisk($akcja)
!endif
}
!endprocedure

' Grupy z planów PWr (budynek szczegółowy): winda i toaleta, piętra tekstem
' z „Pokaż na planie” (decyzja 44), podpis źródła (NFR-40).
!procedure $grupy_pwr()
$sekcja("Winda i toaleta")
$ramka()
<b>Winda</b>
$tekst("[piętra z windą, z danych]", "i")
$tekst("Toaleta dla osób z niepełnosprawnością", "b")
$tekst("[piętra z toaletą, z danych]", "i")
}
$sekcja("Piętra")
$ramka()
<b><i>[etykieta piętra]</i></b>
$tekst("[opis z funkcji pomieszczeń]", "i")
$przycisk("Pokaż na planie")
}
<i>[kolejne piętra w tym samym układzie]</i>
!endprocedure

' Dół karty: podpis źródła; bez przypiętego pasa czynności (decyzja 115).
!procedure $karta_dol()
..
Źródło: Politechnika Wrocławska
!endprocedure
