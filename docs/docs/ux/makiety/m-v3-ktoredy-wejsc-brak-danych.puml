@startsalt
' V3 Którędy wejść, stan: brak danych o części wejść (UC4 4b, US17.1).
!include _wspolne.iuml
$ekran_poczatek()
$naglowek("Którędy wejść do <i>[symbol]</i>")
$tekst("Nie wiemy jeszcze, czy budynek <i>[symbol]</i> ma wejście dostępne: brak danych o <i>[x]</i> z <i>[y]</i> wejść.", "b")
$tekst("Wybierz »Wstecz«, aby w opisie budynku zobaczyć każde wejście z datą.")
$pasek_dolny_konto()
$ekran_koniec()
@endsalt
