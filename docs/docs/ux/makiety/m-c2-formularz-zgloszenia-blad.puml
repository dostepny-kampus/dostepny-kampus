!include _wspolne.iuml
!include _zespol-w-terenie.iuml
$ekran_poczatek()
$naglowek("Formularz zgłoszenia")
$komunikat("Brakuje typu bariery. Uzupełnij to pole, aby zapisać.")
<b>Budynek A-1</b>
<i>[miejsce z pomiaru]</i>
$przycisk("Zmień miejsce")
$sekcja("Piętro")
{ ( ) <i>[1]</i>$dk_spacje(2) | (X) <i>[2]</i>$dk_spacje(2) | ( ) <i>[3]</i>$dk_spacje(2) | ( ) <i>[4]</i>$dk_spacje(2) | ( ) <i>[5]</i> }
$sekcja("Typ bariery")
$blad_pola("Brakuje typu bariery. Uzupełnij to pole, aby zapisać.")
^<i>[typy w 6 grupach barier]</i>^
$sekcja("Uciążliwość")
$opcja("", $utrudnienie(), "Osoba pokona ją sama, ale z dodatkowym wysiłkiem lub ryzykiem.")
