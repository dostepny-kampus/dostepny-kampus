$ramka()
{ <b>Sala 329</b>$dk_spacje(14) | [Zamknij] }
{ <b>Krok 1 z 3</b>$dk_spacje(6) | <b>Wszystkie kroki</b> }
<i>[pasek postępu: 1 z 3]</i>
{+
(1) <b><i>[wejście zalecane]</i></b>
Parter, <i>[położenie wejścia]</i>
<b>Szczegóły wejścia ›</b>
}
{ [‹ Wstecz] | [Dalej ›] }
}
$pasek_dolny_konto()
$ekran_koniec()
@endsalt
