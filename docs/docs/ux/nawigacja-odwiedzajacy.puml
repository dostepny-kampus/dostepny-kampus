@startuml
!pragma layout smetana
hide empty description
skinparam defaultFontSize 14
skinparam ArrowColor #444444
skinparam ArrowFontSize 12
skinparam state {
  BackgroundColor #F2F2F2
  BorderColor #444444
  FontStyle bold
}
skinparam state<<poza>> {
  BackgroundColor #FFFFFF
  BorderColor #888888
  FontStyle italic
}
skinparam state<<stan>> {
  BackgroundColor #FFFFFF
  BorderColor #444444
  FontStyle normal
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #888888
}

state "V5 Pomoc" as V5
state "V1 Mapa kampusu" as V1
state "V2 Karta budynku" as V2
state "V3 Którędy wejść" as V3
state "Pasek dolny\nna V1, V2, V3, V5, L2" as PASEK <<stan>>
state "L1 Prośba o logowanie" as L1
state "L2 Konto" as L2
state "Klauzula\ninformacyjna" as KL <<stan>>
state "Wycofanie zgody:\npotwierdzenie" as WZ <<stan>>
state "Strona logowania\nw przeglądarce" as WWW <<poza>>
state "Ustawienia telefonu" as UST <<poza>>

state "V4 Zgłoszenie szybkie" as V4 {
  state "Sprawdzenie zgody\nna lokalizację: brak,\nprzybliżona, odmowa,\nwyłączona" as ZG <<stan>>
  state "Krok 1 z 3\nzdjęcie" as K1
  state "Krok 2 z 3\ngrupa barier" as K2
  state "Krok 3 z 3\nwysłanie" as K3
  state "Brak pozycji" as BP <<stan>>
  state "Potwierdzenie\nrezygnacji" as PR <<stan>>
  state "Potwierdzenie" as POT
}

[*] --> V5 : pierwsze\nuruchomienie
[*] --> V1 : kolejne\nuruchomienie
V5 --> V1 : „Zacznij”,\n„Pomiń instrukcję”
V1 --> V2 : budynek, wynik\nwyszukiwania, bariera
V2 --> V1 : „Wstecz”\n(budynek zaznaczony)
V2 --> V3 : „Sprawdź,\nktórędy wejść”
V3 --> V2 : „Wstecz”

PASEK --> V1 : „Mapa”
PASEK --> V5 : „Pomoc”
PASEK --> ZG : „Zgłoś barierę”\n(zalogowani)
PASEK --> L1 : „Zgłoś barierę”,\n„Konto” (Gość)
PASEK --> L2 : „Konto”; role\npracownicze:\n„Konto i praca”

ZG --> K1 : zgoda jest\nalbo „Pozwól na\nlokalizację”
ZG --> UST : „Otwórz\nustawienia”
ZG --> V1 : „Wróć do mapy”
K1 --> K2 : „Zrób zdjęcie”;\nze zdjęciem „Dalej”
K2 --> K3 : wybór grupy
K2 --> K1 : „Wstecz”
K1 --> PR : „Wstecz”\n(zdjęcie\nzrobione)
K3 --> K2 : „Wstecz”
K3 --> POT : „Wyślij”;\nbez sieci: zapis\nw telefonie
K3 --> BP : telefon nie\nustalił pozycji
BP --> K3 : „Spróbuj\nponownie”
BP --> PR : „Zrezygnuj”
PR --> BP : „Wróć do\nzdjęcia”
PR --> V1 : „Tak,\nzrezygnuj”
POT --> V1 : „Wróć do mapy”

L1 --> WWW : „Zaloguj się”,\n„Załóż konto”
WWW --> K1 : po zalogowaniu\nalbo rejestracji z V4
WWW --> L2 : po zalogowaniu\nz „Konto”
L1 --> V1 : „Nie teraz”;\nbrak sieci: „Wróć do mapy”

L2 --> V1 : „Wyloguj się”
L2 --> WZ : „Wycofaj zgodę”
WZ --> L2 : „Zostaw zgodę”
WZ --> V1 : „Wycofaj zgodę”\n(wylogowanie)
L2 --> KL : „Informacja\no danych\nosobowych”
KL --> L2 : „Wstecz”

note right of PR
  Po „Wstecz” z kroku 1:
  „Tak, zrezygnuj” wraca do
  ekranu sprzed V4, „Wróć do
  zdjęcia” do kroku 1.
end note

note bottom of POT
  „Wstecz” z potwierdzenia
  wraca do ekranu sprzed V4,
  nie do kroku 3.
end note
@enduml
