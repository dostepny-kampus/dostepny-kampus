@startuml
!pragma layout smetana
hide empty description
skinparam defaultFontSize 14
skinparam ArrowColor #2B5A8C
skinparam ArrowFontSize 13
skinparam state {
  BackgroundColor #EEF4FB
  BorderColor #2B5A8C
  FontStyle bold
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #B08900
}

state "lokalne" as L
state "wysłane" as W
state "w weryfikacji" as V
state "przyjęte" as P
state "odrzucone" as O
state "archiwalne" as A

[*] --> L : zapis w telefonie\n(BR-7, BR-8)
L --> W : serwer potwierdził\nodbiór (BR-9)
W --> V : Weryfikator bierze\n(BR-4, BR-11)
V --> W : zwolnienie\nbez decyzji (BR-12)
V --> P : przyjęcie\n(BR-14, BR-15)
V --> O : odrzucenie z powodem\n(BR-13, BR-16)
O --> W : poprawka i ponowne\nwysłanie (BR-3)
O --> [*] : usunięcie po 90 dniach\n(NFR-29)
P --> A : przyjęto zmianę\nlub „bariera usunięta”\n(BR-18, BR-19)
V --> A : przyjęcie\n„bariera usunięta”\n(BR-19)

note left of P
  Zmiana przyjętego =
  nowe zgłoszenie
  od statusu „lokalne” (BR-18).
end note

note bottom of A
  Poza mapą i eksportem,
  zostaje w historii.
end note

note left of W
  Edycja Zbierającego przed decyzją
  nie zmienia statusu,
  tylko tworzy nową wersję (BR-3).
  Konflikt wersji: Zbierający wybiera
  wersję własną albo z serwera (BR-10).
end note
@enduml
