<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_ToBe"
                  targetNamespace="https://dostepny-kampus.example/bpmn/to-be">

  <bpmn:signal id="Signal_Kolejka" name="Zgłoszenie w kolejce" />
  <bpmn:dataStore id="Store_Zgloszenia" name="Zgłoszenia przyjęte" />
  <bpmn:dataStore id="Store_Postep" name="Postęp inwentaryzacji" />
  <bpmn:dataStore id="Store_Wejscia" name="Oznaczenia wejść" />

  <bpmn:collaboration id="Collaboration_ToBe">
    <bpmn:participant id="Participant_Zglaszanie" name="A. Zgłaszanie bariery" processRef="Process_Zglaszanie" />
    <bpmn:participant id="Participant_Weryfikacja" name="B. Weryfikacja, publikacja i przeglądanie" processRef="Process_Weryfikacja" />
    <bpmn:participant id="Participant_Koordynacja" name="C. Koordynacja inwentaryzacji" processRef="Process_Koordynacja" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Zglaszanie" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Zglaszanie">
      <bpmn:lane id="Lane_A_Zbierajacy" name="Zbierający">
        <bpmn:flowNodeRef>Start_Pomiar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Zmiana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T6a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Oznaczenie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T6b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_A_System" name="System (aplikacja i serwer)">
        <bpmn:flowNodeRef>Task_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Kontur</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Kontur_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Zapis_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Siec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Siec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Siec_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Konflikt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Kolejka</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_A_Odwiedzajacy" name="Odwiedzający">
        <bpmn:flowNodeRef>Start_Szybkie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Pomiar" name="Bariera zauważona">
      <bpmn:outgoing>Flow_A01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_T1" name="T1 Rozpocznij pomiar precyzyjny">
      <bpmn:incoming>Flow_A01</bpmn:incoming>
      <bpmn:outgoing>Flow_A02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_T2" name="T2 Uśrednij pozycję przez 30 s">
      <bpmn:incoming>Flow_A02</bpmn:incoming>
      <bpmn:outgoing>Flow_A03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Kontur" name="Punkt w konturze budynku?">
      <bpmn:incoming>Flow_A03</bpmn:incoming>
      <bpmn:outgoing>Flow_A04</bpmn:outgoing>
      <bpmn:outgoing>Flow_A05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_T3" name="T3 Podpowiedz najbliższy budynek">
      <bpmn:incoming>Flow_A04</bpmn:incoming>
      <bpmn:outgoing>Flow_A06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_T4" name="T4 Oznacz „poza budynkiem”">
      <bpmn:incoming>Flow_A05</bpmn:incoming>
      <bpmn:outgoing>Flow_A07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Kontur_Merge">
      <bpmn:incoming>Flow_A06</bpmn:incoming>
      <bpmn:incoming>Flow_A07</bpmn:incoming>
      <bpmn:outgoing>Flow_A08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_T5" name="T5 Potwierdź budynek, popraw punkt">
      <bpmn:incoming>Flow_A08</bpmn:incoming>
      <bpmn:outgoing>Flow_A09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_T6" name="T6 Wypełnij formularz i zrób zdjęcie">
      <bpmn:incoming>Flow_A09</bpmn:incoming>
      <bpmn:outgoing>Flow_A10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Start_Zmiana" name="Zmiana zgłoszenia przyjętego">
      <bpmn:outgoing>Flow_A26</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_T6a" name="T6a Zmiana lub „bariera usunięta”, nowe zdjęcie">
      <bpmn:incoming>Flow_A26</bpmn:incoming>
      <bpmn:outgoing>Flow_A27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Start_Oznaczenie" name="Wejście sprawdzone na obchodzie">
      <bpmn:outgoing>Flow_A28</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_T6b" name="T6b Zmień oznaczenie wejścia, zrób zdjęcie">
      <bpmn:incoming>Flow_A28</bpmn:incoming>
      <bpmn:outgoing>Flow_A29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Start_Szybkie" name="Bariera zauważona">
      <bpmn:outgoing>Flow_A11</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_T7" name="T7 Zrób zdjęcie bariery">
      <bpmn:incoming>Flow_A11</bpmn:incoming>
      <bpmn:outgoing>Flow_A12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_T8" name="T8 Wybierz grupę barier">
      <bpmn:incoming>Flow_A12</bpmn:incoming>
      <bpmn:outgoing>Flow_A13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_T9" name="T9 Dołącz bieżącą pozycję">
      <bpmn:incoming>Flow_A13</bpmn:incoming>
      <bpmn:outgoing>Flow_A14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Zapis_Merge">
      <bpmn:incoming>Flow_A10</bpmn:incoming>
      <bpmn:incoming>Flow_A14</bpmn:incoming>
      <bpmn:outgoing>Flow_A15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_T10" name="T10 Zapisz w telefonie (lokalne)">
      <bpmn:incoming>Flow_A15</bpmn:incoming>
      <bpmn:incoming>Flow_A27</bpmn:incoming>
      <bpmn:incoming>Flow_A29</bpmn:incoming>
      <bpmn:outgoing>Flow_A16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Siec" name="Sieć dostępna?">
      <bpmn:incoming>Flow_A16</bpmn:incoming>
      <bpmn:outgoing>Flow_A17</bpmn:outgoing>
      <bpmn:outgoing>Flow_A18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_Siec" name="Sieć wróciła">
      <bpmn:incoming>Flow_A18</bpmn:incoming>
      <bpmn:outgoing>Flow_A19</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CondDef_Event_Siec">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Sieć dostępna</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Siec_Merge">
      <bpmn:incoming>Flow_A17</bpmn:incoming>
      <bpmn:incoming>Flow_A19</bpmn:incoming>
      <bpmn:outgoing>Flow_A20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_T11" name="T11 Synchronizuj">
      <bpmn:incoming>Flow_A20</bpmn:incoming>
      <bpmn:incoming>Flow_A23</bpmn:incoming>
      <bpmn:outgoing>Flow_A21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Konflikt" name="Konflikt wersji?">
      <bpmn:incoming>Flow_A21</bpmn:incoming>
      <bpmn:outgoing>Flow_A22</bpmn:outgoing>
      <bpmn:outgoing>Flow_A24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_T12" name="T12 Wybierz wersję">
      <bpmn:incoming>Flow_A22</bpmn:incoming>
      <bpmn:outgoing>Flow_A23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_T13" name="T13 Przyjmij na serwerze (wysłane)">
      <bpmn:incoming>Flow_A24</bpmn:incoming>
      <bpmn:outgoing>Flow_A25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Kolejka" name="Zgłoszenie w kolejce">
      <bpmn:incoming>Flow_A25</bpmn:incoming>
      <bpmn:signalEventDefinition id="SigDef_End_Kolejka" signalRef="Signal_Kolejka" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A01" sourceRef="Start_Pomiar" targetRef="Task_T1" />
    <bpmn:sequenceFlow id="Flow_A02" sourceRef="Task_T1" targetRef="Task_T2" />
    <bpmn:sequenceFlow id="Flow_A03" sourceRef="Task_T2" targetRef="Gateway_Kontur" />
    <bpmn:sequenceFlow id="Flow_A04" name="tak" sourceRef="Gateway_Kontur" targetRef="Task_T3" />
    <bpmn:sequenceFlow id="Flow_A05" name="nie" sourceRef="Gateway_Kontur" targetRef="Task_T4" />
    <bpmn:sequenceFlow id="Flow_A06" sourceRef="Task_T3" targetRef="Gateway_Kontur_Merge" />
    <bpmn:sequenceFlow id="Flow_A07" sourceRef="Task_T4" targetRef="Gateway_Kontur_Merge" />
    <bpmn:sequenceFlow id="Flow_A08" sourceRef="Gateway_Kontur_Merge" targetRef="Task_T5" />
    <bpmn:sequenceFlow id="Flow_A09" sourceRef="Task_T5" targetRef="Task_T6" />
    <bpmn:sequenceFlow id="Flow_A10" sourceRef="Task_T6" targetRef="Gateway_Zapis_Merge" />
    <bpmn:sequenceFlow id="Flow_A11" sourceRef="Start_Szybkie" targetRef="Task_T7" />
    <bpmn:sequenceFlow id="Flow_A12" sourceRef="Task_T7" targetRef="Task_T8" />
    <bpmn:sequenceFlow id="Flow_A13" sourceRef="Task_T8" targetRef="Task_T9" />
    <bpmn:sequenceFlow id="Flow_A14" sourceRef="Task_T9" targetRef="Gateway_Zapis_Merge" />
    <bpmn:sequenceFlow id="Flow_A15" sourceRef="Gateway_Zapis_Merge" targetRef="Task_T10" />
    <bpmn:sequenceFlow id="Flow_A16" sourceRef="Task_T10" targetRef="Gateway_Siec" />
    <bpmn:sequenceFlow id="Flow_A17" name="tak" sourceRef="Gateway_Siec" targetRef="Gateway_Siec_Merge" />
    <bpmn:sequenceFlow id="Flow_A18" name="nie" sourceRef="Gateway_Siec" targetRef="Event_Siec" />
    <bpmn:sequenceFlow id="Flow_A19" sourceRef="Event_Siec" targetRef="Gateway_Siec_Merge" />
    <bpmn:sequenceFlow id="Flow_A20" sourceRef="Gateway_Siec_Merge" targetRef="Task_T11" />
    <bpmn:sequenceFlow id="Flow_A21" sourceRef="Task_T11" targetRef="Gateway_Konflikt" />
    <bpmn:sequenceFlow id="Flow_A22" name="tak" sourceRef="Gateway_Konflikt" targetRef="Task_T12" />
    <bpmn:sequenceFlow id="Flow_A23" sourceRef="Task_T12" targetRef="Task_T11" />
    <bpmn:sequenceFlow id="Flow_A24" name="nie" sourceRef="Gateway_Konflikt" targetRef="Task_T13" />
    <bpmn:sequenceFlow id="Flow_A25" sourceRef="Task_T13" targetRef="End_Kolejka" />
    <bpmn:sequenceFlow id="Flow_A26" sourceRef="Start_Zmiana" targetRef="Task_T6a" />
    <bpmn:sequenceFlow id="Flow_A27" sourceRef="Task_T6a" targetRef="Task_T10" />
    <bpmn:sequenceFlow id="Flow_A28" sourceRef="Start_Oznaczenie" targetRef="Task_T6b" />
    <bpmn:sequenceFlow id="Flow_A29" sourceRef="Task_T6b" targetRef="Task_T10" />
    <bpmn:textAnnotation id="Note_Konflikt">
      <bpmn:text>Konflikt możliwy przy edycji zgłoszenia (BR-3)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Offline">
      <bpmn:text>Tryb offline: zgłoszenie czeka w telefonie (NFR-5, NFR-6)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_PozaBudynkiem">
      <bpmn:text>Stan normalny; blisko budynku podpowiedź (BR-G2), daleko bez podpowiedzi (BR-G4)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_Konflikt" sourceRef="Note_Konflikt" targetRef="Gateway_Konflikt" />
    <bpmn:association id="Assoc_Note_Offline" sourceRef="Note_Offline" targetRef="Event_Siec" />
    <bpmn:association id="Assoc_Note_PozaBudynkiem" sourceRef="Note_PozaBudynkiem" targetRef="Task_T4" />
    <bpmn:textAnnotation id="Note_Zmiana">
      <bpmn:text>Autor; przy zgłoszeniu szybkim i „bariera usunięta” dowolny Zbierający (BR-18, BR-19)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Note_Zmiana" sourceRef="Note_Zmiana" targetRef="Task_T6a" />
  </bpmn:process>

  <bpmn:process id="Process_Weryfikacja" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Weryfikacja">
      <bpmn:lane id="Lane_B_Weryfikator" name="Weryfikator">
        <bpmn:flowNodeRef>Task_T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decyzja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T18</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_B_System" name="System (aplikacja i serwer)">
        <bpmn:flowNodeRef>Start_Kolejka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Usunieta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T17a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Usunieta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Odrzucone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Opublikowane</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_B_Gosc" name="Odwiedzający / Gość niezalogowany">
        <bpmn:flowNodeRef>Start_Wizyta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Szczegolowy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Szczegolowy_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_T23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Wizyta</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Kolejka" name="Zgłoszenie w kolejce">
      <bpmn:outgoing>Flow_B01</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SigDef_Start_Kolejka" signalRef="Signal_Kolejka" />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_T14" name="T14 Weź zgłoszenie z kolejki">
      <bpmn:incoming>Flow_B01</bpmn:incoming>
      <bpmn:outgoing>Flow_B02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_T15" name="T15 Ustaw „w weryfikacji”, znajdź podobne">
      <bpmn:incoming>Flow_B02</bpmn:incoming>
      <bpmn:outgoing>Flow_B03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_T16" name="T16 Sprawdź dane, zdjęcie i podobne">
      <bpmn:incoming>Flow_B03</bpmn:incoming>
      <bpmn:outgoing>Flow_B04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Decyzja" name="Poprawne i nie duplikat?">
      <bpmn:incoming>Flow_B04</bpmn:incoming>
      <bpmn:outgoing>Flow_B05</bpmn:outgoing>
      <bpmn:outgoing>Flow_B08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_T18" name="T18 Odrzuć z powodem">
      <bpmn:incoming>Flow_B05</bpmn:incoming>
      <bpmn:outgoing>Flow_B06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_T19" name="T19 Ustaw „odrzucone”, pokaż powód Zbierającemu">
      <bpmn:incoming>Flow_B06</bpmn:incoming>
      <bpmn:outgoing>Flow_B07</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_T19_Postep">
        <bpmn:targetRef>DataStore_Postep_B</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Odrzucone" name="Zgłoszenie odrzucone">
      <bpmn:incoming>Flow_B07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Usunieta" name="Rodzaj zgłoszenia?">
      <bpmn:incoming>Flow_B08</bpmn:incoming>
      <bpmn:outgoing>Flow_B18</bpmn:outgoing>
      <bpmn:outgoing>Flow_B19</bpmn:outgoing>
      <bpmn:outgoing>Flow_B21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_T17a" name="T17a Oba zgłoszenia „archiwalne”, usuń barierę z mapy">
      <bpmn:incoming>Flow_B18</bpmn:incoming>
      <bpmn:outgoing>Flow_B20</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_T17a_Postep">
        <bpmn:targetRef>DataStore_Postep_B</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Usunieta" name="Bariera zniknęła z mapy">
      <bpmn:incoming>Flow_B20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_T17b" name="T17b Zgłoszenie „archiwalne”, nowe oznaczenie wejścia z datą i źródłem">
      <bpmn:incoming>Flow_B21</bpmn:incoming>
      <bpmn:outgoing>Flow_B22</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_T17b_Wejscia">
        <bpmn:targetRef>DataStore_Wejscia</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOut_T17b_Postep">
        <bpmn:targetRef>DataStore_Postep_B</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Oznaczenie" name="Nowe oznaczenie wejścia">
      <bpmn:incoming>Flow_B22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_T17" name="T17 Ustaw „przyjęte”, opublikuj, poprzednie archiwalne">
      <bpmn:incoming>Flow_B19</bpmn:incoming>
      <bpmn:outgoing>Flow_B09</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_T17">
        <bpmn:targetRef>DataStore_Przyjete</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DataOut_T17_Postep">
        <bpmn:targetRef>DataStore_Postep_B</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Opublikowane" name="Bariera na mapie">
      <bpmn:incoming>Flow_B09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Wizyta" name="Planuje wizytę">
      <bpmn:outgoing>Flow_B10</bpmn:outgoing>
