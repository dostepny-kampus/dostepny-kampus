{
  "realm": "dostepny-kampus",
  "displayName": "Dostępny Kampus",
  "enabled": true,
  "sslRequired": "external",
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "registrationAllowed": true,
  "groups": [{ "name": "odwiedzajacy", "realmRoles": ["VISITOR"] }],
  "defaultGroups": ["/odwiedzajacy"],
  "roles": {
    "realm": [
      {
        "name": "VISITOR",
        "description": "Odwiedzający (konto z kontraktu API)"
      },
      {
        "name": "COLLECTOR",
        "description": "Zbierający (konto z kontraktu API)"
      },
      {
        "name": "VERIFIER",
        "description": "Weryfikator (konto z kontraktu API)"
      },
      {
        "name": "COORDINATOR",
        "description": "Koordynator (konto z kontraktu API)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dostepny-kampus-android",
      "name": "Aplikacja Dostępny Kampus",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "io.github.dostepnykampus:/oauth2redirect"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "odbiorca-serwera",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "dostepny-kampus-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
