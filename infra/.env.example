# Wartości przykładowe tylko do pracy lokalnej. Skopiuj plik do infra/.env i ustaw własne hasło.
# Te same zmienne czyta serwer (backend/src/main/resources/application.yaml).
DK_DB_NAME=dostepny_kampus
DK_DB_USER=dostepny_kampus
DK_DB_PASSWORD=haslo-testowe
# Konto serwera bez praw do zmiany schematu; migracje idą na koncie DK_DB_USER.
DK_DB_APP_USER=dostepny_kampus_serwer
DK_DB_APP_PASSWORD=haslo-testowe-serwera
DK_DB_PORT=5432
# Klucz główny magazynu tylko do administracji; serwer dostaje klucz ograniczony do kubełka zdjęć.
DK_PHOTOS_ROOT_ACCESS_KEY=dostepny-kampus-admin
DK_PHOTOS_ROOT_SECRET_KEY=haslo-testowe-magazynu
DK_PHOTOS_ACCESS_KEY=dostepny-kampus
DK_PHOTOS_SECRET_KEY=haslo-testowe-zdjec
DK_PHOTOS_PORT=9000
# Konto administratora usługi logowania, tylko lokalnie.
DK_AUTH_ADMIN_USER=admin
DK_AUTH_ADMIN_PASSWORD=haslo-testowe-logowania
DK_AUTH_PORT=8180
DK_AUTH_SERVICE_SECRET=haslo-testowe-konta-serwera
# Port serwera na 127.0.0.1, gdy serwer działa w compose (usługa serwer).
DK_API_PORT=8080
# Baza usługi logowania w nakładce produkcyjnej (docker-compose.produkcja.yml).
DK_AUTH_DB_NAME=logowanie
# Nazwa hosta serwera docelowego z rekordem DNS na ten komputer; tylko nakładka produkcyjna.
# DK_PUBLIC_HOST=kampus.example.org
