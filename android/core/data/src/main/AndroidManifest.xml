<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Stan internetu dla linii „Bez internetu” (US9.1, NFR-10). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Przezroczysty most między logowaniem w przeglądarce (AppAuth) a sesją konta (US14.2, NFR-31). -->
        <activity
            android:name=".account.LoginActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Powrót z przeglądarki na przekierowanie io.github.dostepnykampus:/oauth2redirect (US14.2). -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true"
            tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="io.github.dostepnykampus" />
            </intent-filter>
        </activity>
    </application>
</manifest>
